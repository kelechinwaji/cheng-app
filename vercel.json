{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "env": {
    "DATA_DIR": "/tmp/cheng-ledger-data"
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/better-sqlite3/**,node_modules/bindings/**,node_modules/file-uri-to-path/**}"
    }
  }
}
