PORT=1337
DATA_DIR=./data
OPENING_BALANCE=0
OPENING_BALANCE_AT=
DEFAULT_CURRENCY=NGN

# Gmail label that receives all three banks (filter by sender into one label)
GMAIL_LABEL=Bank/Transactions

# OAuth — create at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:1337/api/oauth/callback

# After OAuth flow, copy refresh token here (or it is saved in SQLite settings)
GMAIL_REFRESH_TOKEN=

# Optional: comma-separated sender substrings per bank for routing
# BANK_A_FROM=gtbank.com,gtbank
# BANK_B_FROM=accessbank.com
# BANK_C_FROM=zenithbank.com
